# PostgreSQL Database URL
# In development, you can use SQLite: sqlite:///project.db
# In production, Render will automatically provide the DATABASE_URL environment variable.
DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# Flask Configuration
FLASK_DEBUG=True
FLASK_SECRET_KEY=generate-a-safe-random-key-here

# Admin Dashboard Credentials
# Set these as environment variables on Render — never commit real values!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password-here
